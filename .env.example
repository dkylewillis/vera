# Copy to `.env` for local CLI / tooling and `npm run app:dev`.
# A source-run desktop process reads this file. A packaged installer uses
# pro-cloud.json instead. Values already set in the shell win. Do not commit `.env`.

# Public VERA Pro connection. Leave blank to run without Account sign-in.
VERA_PRO_SITE_URL=
VERA_PRO_SUPABASE_URL=
VERA_PRO_SUPABASE_ANON_KEY=
VERA_PRO_RELAY_URL=

# Used by Hugging Face Hub downloads (Docling layout models, some embedders).
# The desktop app also accepts a token saved under Settings > Hugging Face.
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional aliases / related knobs:
# HUGGING_FACE_HUB_TOKEN=
# HF_HUB_OFFLINE=1
# DOCLING_ARTIFACTS_PATH=

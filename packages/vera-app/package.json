{
  "name": "@vera/app",
  "version": "0.2.0",
  "description": "Desktop workspace for VERA documents",
  "author": "Kyle Willis",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "predev": "npm run build:electron && npm run typecheck:renderer",
    "dev": "concurrently -k --success first \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "npm run build:electron && npm run typecheck:renderer && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:sidecar": "node scripts/build-sidecar.cjs",
    "dist": "npm run build && npm run build:sidecar && electron-builder",
    "typecheck": "npm run typecheck:electron && npm run typecheck:renderer",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "test:unit": "vitest run",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "1.21.0",
    "pdfjs-dist": "6.0.227",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.4",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  },
  "build": {
    "appId": "dev.vera.desktop",
    "productName": "VERA",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/sidecar/vera-sidecar",
        "to": "python/sidecar"
      },
      {
        "from": "src/vera_app/modes_builtin",
        "to": "python/vera_app/modes_builtin"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
